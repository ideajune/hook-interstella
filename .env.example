# HOOK INTERSTELLAR — Environment Variables Configuration (.env.example)
# Copy this file to .env.local for local development or configure in Vercel Dashboard.

# 1. Site URL (Used for canonical URLs, OpenGraph, sitemap.xml)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Session & Security Secret (Required in production for signing session cookies)
SESSION_SECRET=replace_with_32_byte_random_hex_string_in_production

# 3. Database Connection (Optional in local file-DB mode; Required when switching to PostgreSQL / Supabase)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
